[
    {
        "id": "edibility_basics",
        "name": "Basic Edibility Properties",
        "type": "property",
        "difficulty": 2,
        "prerequisites": [
            "basic_associations"
        ],
        "examples": [
            {
                "inputs": [
                    {
                        "id": "meat",
                        "energy": 1.0
                    }
